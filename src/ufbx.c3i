struct Vec2 {
    union {
        struct {
            double x;
            double y;
        }
        double[2] v;
    }
}

struct Vec3 {
    union {
        struct {
            double x;
            double y;
            double z;
        }
        double[3] v;
    }
}

struct Vec4 {
    union {
        struct {
            double x;
            double y;
            double z;
            double w;
        }
        double[4] v;
    }
}

struct Quat {
    union {
        struct {
            double x;
            double y;
            double z;
            double w;
        }
        double[4] v;
    }
}

struct Transform {
    Vec3 translation;
    Quat rotation;
    Vec3 scale;
}

struct Matrix {
    union {
        struct {
            double m00;
            double m10;
            double m20;
            double m01;
            double m11;
            double m21;
            double m02;
            double m12;
            double m22;
            double m03;
            double m13;
            double m23;
        }
        Vec3[4] cols;
        double[12] v;
    }
}

struct VoidList {
    void* data;
    usz count;
}

struct DomValue {
    DomValueType type;
    String value_str;
    char[] value_blob;
    long value_int;
    double value_float;
}

struct DomNode {
    String name;
    DomNode*[] children;
    DomValue[] values;
}

struct Prop {
    String name;
    uint _internal_key;
    PropType type;
    PropFlags flags;
    String value_str;
    char[] value_blob;
    long value_int;
    union {
        double[4] value_real_arr;
        double value_real;
        Vec2 value_vec2;
        Vec3 value_vec3;
        Vec4 value_vec4;
    }
}

struct Props {
    Prop[] props;
    usz num_animated;
    Props* defaults;
}

struct Connection {
    Element* src;
    Element* dst;
    String src_prop;
    String dst_prop;
}

struct Element {
    String name;
    Props props;
    uint element_id;
    uint typed_id;
    Node*[] instances;
    ElementType type;
    Connection[] connections_src;
    Connection[] connections_dst;
    DomNode* dom_node;
    Scene* scene;
}

struct Unknown {
    union {
        Element element;
        struct {
            String name;
            Props props;
            uint element_id;
            uint typed_id;
        }
    }
    String type;
    String super_type;
    String sub_type;
}

struct Node {
    union {
        Element element;
        struct {
            String name;
            Props props;
            uint element_id;
            uint typed_id;
        }
    }
    Node* parent;
    Node*[] children;
    Mesh* mesh;
    Light* light;
    Camera* camera;
    Bone* bone;
    Element* attrib;
    Node* geometry_transform_helper;
    Node* scale_helper;
    ElementType attrib_type;
    Element*[] all_attribs;
    InheritMode inherit_mode;
    InheritMode original_inherit_mode;
    Transform local_transform;
    Transform geometry_transform;
    Vec3 inherit_scale;
    Node* inherit_scale_node;
    RotationOrder rotation_order;
    Vec3 euler_rotation;
    Matrix node_to_parent;
    Matrix node_to_world;
    Matrix geometry_to_node;
    Matrix geometry_to_world;
    Matrix unscaled_node_to_world;
    Vec3 adjust_pre_translation;
    Quat adjust_pre_rotation;
    double adjust_pre_scale;
    Quat adjust_post_rotation;
    double adjust_post_scale;
    double adjust_translation_scale;
