struct MetadataObject {
    union {
        Element element;
        struct {
            String name;
            Props props;
            uint element_id;
            uint typed_id;
        }
    }
}

struct NameElement {
    String name;
    ElementType type;
    uint _internal_key;
    Element* element;
}

struct Application {
    String vendor;
    String name;
    String version;
}

struct Warning {
    WarningType type;
    String description;
    uint element_id;
    usz count;
}

struct Thumbnail {
    Props props;
